    "diagnostics.finding.balance.apart": {
      "comment": "Fan balance check: one fan runs much faster than another",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One fan is running %lld rpm faster than another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ventilador gira %lld rpm más rápido que otro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один вентилятор вращается на %lld об/мин быстрее другого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fan diğerinden %lld dev/dk daha hızlı dönüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个风扇比另一个快 %lld 转/分。"
          }
        }
      }
    },
    "diagnostics.finding.balance.single": {
      "comment": "Fan balance check: does not apply on a single fan Mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has a single fan, so there is nothing to compare it against."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac tiene un solo ventilador, así que no hay con qué compararlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом Mac один вентилятор, сравнивать не с чем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te tek fan var, dolayısıyla karşılaştırılacak bir şey yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 只有一个风扇，没有可比较的对象。"
          }
        }
      }
    },
    "diagnostics.finding.balance.together": {
      "comment": "Fan balance check: the fans run together",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans are within %lld rpm of each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores no se separan más de %lld rpm entre sí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы отличаются не более чем на %lld об/мин."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar birbirinden en çok %lld dev/dk ayrı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个风扇之间的差异不超过 %lld 转/分。"
          }
        }
      }
    },
    "diagnostics.finding.balance.unreadable": {
      "comment": "Fan balance check: no speeds to compare",
      "extractionState": "manual",
      "localizations": {
