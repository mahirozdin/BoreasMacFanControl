    "settings.notify.quiet.note": {
      "comment": "Explains that the panic notification ignores quiet hours",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-speed cooling is still announced during quiet hours. Everything else waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La refrigeración a velocidad máxima se anuncia también en las horas de silencio. Todo lo demás espera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Об охлаждении на полной скорости сообщается и в тихие часы. Всё остальное ждёт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam hızda soğutma sessiz saatlerde de bildirilir. Diğer her şey bekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全速散热在免打扰时段内仍会通知。其他内容都会等待。"
          }
        }
      }
    },
