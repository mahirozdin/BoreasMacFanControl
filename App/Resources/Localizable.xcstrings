    "settings.record.format.jsonl.note": {
      "comment": "Explains what the JSON Lines recording format is good for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line per sample. Best for scripts, and a file cut short by a power loss is still readable up to its last complete line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea por muestra. Lo mejor para scripts, y un archivo cortado por un apagón sigue siendo legible hasta su última línea completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной строке на измерение. Лучше всего для скриптов, и файл, прерванный отключением питания, читается до последней целой строки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her örnek için bir satır. Betikler için en uygunu; elektrik kesintisiyle yarıda kalan bir dosya da son tam satırına kadar okunabilir kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次采样一行。最适合脚本处理；即使因断电而中断，文件也能读到最后一行完整内容。"
          }
        }
      }
    },
