          "stringUnit": {
            "state": "translated",
            "value": "Unrecognised sensors"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanınmayan sensörler"
          }
        }
      }
    },
    "settings.sensors.shown": {
