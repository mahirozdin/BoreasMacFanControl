    "statusitem.warning.body": {
      "comment": "Body of the warning shown when the status item is pushed out",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Boreas status item does not fit in the visible part of the menu bar right now, so its numbers cannot be seen. Compact mode makes the item narrower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo el ítem de Boreas no cabe en la parte visible de la barra de menús, así que sus números no se ven. El modo compacto hace el ítem más estrecho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент Boreas сейчас не помещается в видимую часть строки меню, поэтому его числа не видны. Компактный режим делает элемент уже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas durum öğesi şu anda menü çubuğunun görünen kısmına sığmıyor, bu yüzden sayıları görülemiyor. Sıkışık kip öğeyi daraltır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas 的状态栏图标目前放不进菜单栏的可见区域，因此看不到它的数字。紧凑模式可以让它变窄。"
          }
        }
      }
    },
