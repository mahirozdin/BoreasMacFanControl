    "settings.control.default": {
      "comment": "Setting: which profile arbitration falls back to",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan profil"
          }
        }
      }
    },
    "settings.control.default.help": {
      "comment": "Explains what the default profile is for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when no trigger holds and nothing is selected by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir tetikleyici sağlanmadığında ve elle bir seçim yapılmadığında kullanılır."
          }
        }
      }
    },
    "settings.control.firmware": {
      "comment": "Description of the System profile in the profile list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the firmware keeps the fans"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fanları donanım yazılımı tutar"
          }
        }
      }
    },
    "settings.control.panic": {
      "comment": "Setting: the K3 trigger temperature",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panic threshold"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panik eşiği"
          }
        }
      }
    },
    "settings.control.panic.help": {
      "comment": "Explains the panic threshold and why it cannot be raised",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above this, every fan goes to full speed and holds there. It can be lowered, never raised above the default — the ceiling is the default (ADR 0022)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun üstünde her fan tam hıza çıkar ve orada kalır. Aşağı çekilebilir, varsayılanın üstüne çıkarılamaz — tavan, varsayılanın kendisidir (ADR 0022)."
          }
        }
      }
    },
    "settings.control.section.profiles": {
      "comment": "Settings section heading: the profile list and default",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiller"
          }
        }
      }
    },
    "settings.control.section.safety": {
      "comment": "Settings section heading: panic threshold and watchdog",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety limits"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik sınırları"
          }
        }
      }
    },
    "settings.control.trigger.none": {
      "comment": "Shown for a profile that is only reachable manually or as the default",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no automatic trigger"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "otomatik tetikleyici yok"
          }
        }
      }
    },
    "settings.control.watchdog": {
      "comment": "Setting shown read-only: how long the helper waits before releasing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchdog timeout"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchdog süresi"
          }
        }
      }
    },
    "settings.control.watchdog.help": {
      "comment": "Explains why the watchdog timeout cannot be changed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed, and shown here as a fact rather than a control: the helper reads no configuration and its message surface is exactly four methods, so there is no way to deliver a different value to it (ADR 0023)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabittir ve burada bir ayar olarak değil, bir olgu olarak gösterilir: yardımcı hiçbir yapılandırma okumaz ve mesaj yüzeyi tam olarak dört metottur, dolayısıyla ona farklı bir değer ulaştırmanın yolu yoktur (ADR 0023)."
          }
        }
      }
    },
    "settings.general.interval": {
      "comment": "Setting: how often the hardware is sampled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read sensors every"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensör okuma sıklığı"
          }
        }
      }
    },
    "settings.general.interval.help": {
      "comment": "Explains the trade-off behind the sampling interval",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter is more responsive and costs a little more power. The control loop follows the same cadence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa aralık daha çevik, biraz da daha fazla güç demek. Kontrol döngüsü de aynı tempoyu izler."
          }
        }
      }
    },
    "settings.general.language.help": {
      "comment": "Explains that the application language is a system setting",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas follows the language order in System Settings. macOS also lets you set a different language for this application alone, under Language & Region."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas, Sistem Ayarları'ndaki dil sıranızı izler. macOS ayrıca yalnızca bu uygulama için farklı bir dil seçmenize izin verir: Dil ve Bölge bölümünden."
          }
        }
      }
    },
    "settings.general.login": {
      "comment": "Setting: register the application as a login item",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at login"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişte başlat"
          }
        }
      }
    },
    "settings.general.login.help": {
      "comment": "Explains what the login item switch does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registers Boreas as a login item. macOS shows it in Login Items, where it can also be turned off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas'ı bir giriş öğesi olarak kaydeder. macOS bunu Giriş Öğeleri altında gösterir; oradan kapatılabilir."
          }
        }
      }
    },
    "settings.general.login.toggle": {
      "comment": "Label of the start-at-login switch",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        }
      }
    },
    "settings.general.section.language": {
      "comment": "Settings section heading: application language",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil"
          }
        }
      }
    },
    "settings.general.section.sampling": {
