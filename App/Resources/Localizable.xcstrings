            "state": "translated",
            "value": "Bu işe yaramadı. Sistemin söylediği:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没有成功。系统的提示是："
          }
        }
      }
    },
    "setup.files.bundle": {
      "comment": "Setup bullet: SMAppService keeps the helper inside the app bundle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper program and its launch definition already sit inside the Boreas app. Installing copies nothing into system folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa asistente y su definición de arranque ya están dentro de la app Boreas. Instalar no copia nada en carpetas del sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа службы и её описание запуска уже находятся внутри приложения Boreas. Установка ничего не копирует в системные папки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı program ve onun başlatma tanımı zaten Boreas uygulamasının içinde duruyor. Kurulum sistem klasörlerine hiçbir şey kopyalamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助程序及其启动定义已经在 Boreas 应用内部。安装过程不会向系统文件夹复制任何东西。"
          }
        }
      }
    },
