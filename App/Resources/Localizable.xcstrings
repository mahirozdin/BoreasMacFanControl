        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS registra la aprobación en su base de datos de ítems en segundo plano. La entrada se ve en Ajustes del Sistema, en Ítems de inicio y extensiones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS записывает разрешение в свою базу фоновых объектов. Запись видна в Системных настройках, в разделе «Объекты входа и расширения»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS onayı arka plan öğeleri veritabanına kaydeder. Kayıt, Sistem Ayarları'nda Giriş Öğeleri ve Uzantılar altında görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会把这次授权记录在它的后台项目数据库中。该条目可在“系统设置”的“登录项与扩展”中看到。"
          }
        }
      }
    },
