    "settings.notify.thresholds.note": {
      "comment": "Explains why notification thresholds ship unset",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no default: what counts as hot depends on the machine and on what you are doing with it. Set one only for the groups you want to hear about."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay valor por omisión: lo que cuenta como caliente depende del equipo y de lo que estés haciendo con él. Fija uno solo para los grupos de los que quieras enterarte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения по умолчанию нет: что считать горячим, зависит от компьютера и от того, что вы на нём делаете. Задайте порог только для тех групп, о которых хотите знать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan bir değer yok: neyin sıcak sayıldığı makineye ve onunla ne yaptığınıza bağlı. Yalnızca haberdar olmak istediğiniz gruplar için bir değer girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有默认值：多热算热，取决于你的机器和你用它做什么。只为你想被提醒的分组设置阈值。"
          }
        }
      }
    },
    "settings.notify.window": {
      "comment": "Label of the notification suppression window stepper",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not repeat the same notice for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No repetir el mismo aviso durante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не повторять одно и то же сообщение в течение"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı bildirimi tekrarlamadan önce beklenecek süre"
          }
        },
        "zh-Hans": {
