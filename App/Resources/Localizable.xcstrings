    "setup.what.admin": {
      "comment": "Setup bullet: single administrator approval (invariant I3)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks an administrator to approve the helper — once. Boreas never sees the password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide a un administrador que apruebe el asistente, una sola vez. Boreas nunca ve la contraseña."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS просит администратора разрешить службу — один раз. Boreas никогда не видит пароль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yardımcıyı onaylaması için bir yöneticiye sorar — bir kez. Boreas parolayı hiçbir zaman görmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会请管理员授权这个辅助程序——只需一次。Boreas 从不会看到密码。"
          }
        }
      }
    },
    "setup.what.heading": {
      "comment": "Heading of the setup section explaining the effects of installing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will happen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué va a pasar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что произойдёт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olacak"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来会发生什么"
          }
        }
      }
    },
    "setup.what.helper": {
      "comment": "Setup bullet: what the privileged helper is",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A helper service is registered. It runs with root privileges and is started by macOS on demand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se registra un servicio asistente. Se ejecuta con privilegios de root y macOS lo arranca cuando hace falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрируется служба. Она работает с правами root и запускается macOS по требованию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yardımcı servis kaydedilir. Root yetkisiyle çalışır ve macOS tarafından gerektiğinde başlatılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会注册一个辅助服务。它以 root 权限运行，由 macOS 按需启动。"
          }
        }
      }
    },
    "setup.what.surface": {
      "comment": "Setup bullet: the helper's deliberately narrow surface (invariants M4-M6)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper only reads fan state and writes fan speeds within hardware limits. It accepts no files or commands and never touches the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente solo lee el estado de los ventiladores y fija su velocidad dentro de los límites del hardware. No acepta archivos ni órdenes y nunca toca la red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба только читает состояние вентиляторов и задаёт их скорость в пределах возможностей оборудования. Она не принимает файлов и команд и никогда не обращается к сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı yalnızca fan durumunu okur ve donanım sınırları içinde fan hızı yazar. Hiçbir dosya ya da komut kabul etmez, ağa hiç dokunmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助程序只读取风扇状态，并在硬件允许的范围内写入风扇转速。它不接受任何文件或命令，也从不接触网络。"
          }
        }
      }
    },
    "setup.window.title": {
      "comment": "Title of the fan control setup window",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Control"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control de ventiladores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление вентиляторами"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Kontrolü"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇控制"
          }
        }
      }
    },
    "shortcut.boost": {
      "comment": "Global shortcut action: run the fans at full speed temporarily",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full speed for a while"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad máxima un rato"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная скорость на время"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süre tam hız"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全速运转一段时间"
          }
        }
      }
    },
    "shortcut.boost.help": {
      "comment": "Explains what the boost shortcut does and how long it lasts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs every fan at full speed for %lld minutes, then hands back to the curve."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pone todos los ventiladores a velocidad máxima durante %lld minuto y después devuelve el control a la curva."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pone todos los ventiladores a velocidad máxima durante %lld minutos y después devuelve el control a la curva."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выводит все вентиляторы на полную скорость на %lld минуты, затем возвращает управление кривой."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выводит все вентиляторы на полную скорость на %lld минут, затем возвращает управление кривой."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выводит все вентиляторы на полную скорость на %lld минуту, затем возвращает управление кривой."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выводит все вентиляторы на полную скорость на %lld минут, затем возвращает управление кривой."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her fanı %lld dakika boyunca tam hızda çalıştırır, sonra direksiyonu eğriye bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所有风扇全速运转 %lld 分钟，然后把控制交回曲线。"
          }
        }
      }
    },
