    "settings.advanced.helper.help": {
      "comment": "Explains what the privileged helper is for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading temperatures never needs the helper. It exists only to write fan speeds, and removing it leaves a fully working monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer temperaturas nunca necesita el asistente. Existe solo para fijar la velocidad de los ventiladores, y al quitarlo queda un monitor perfectamente funcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для чтения температур служба не нужна никогда. Она существует только чтобы задавать скорость вентиляторов, и после её удаления остаётся полностью работающий монитор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcaklık okumak için yardımcıya hiç gerek yok. O yalnızca fan hızı yazmak için var; kaldırdığınızda elinizde tam çalışan bir izleyici kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取温度从来不需要辅助程序。它的唯一用途是写入风扇转速；移除它之后，仍然是一个完整可用的监视器。"
          }
        }
      }
    },
