    "shortcut.release.help": {
      "comment": "Explains what the release shortcut does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns the fans to the Mac's own management, as quitting does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve los ventiladores a la gestión propia del Mac, igual que al salir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает вентиляторы под управление самого Mac, как и выход из приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanları Mac'in kendi yönetimine döndürür; çıkışta olduğu gibi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把风扇交回 Mac 自己的管理，效果与退出应用相同。"
          }
        }
      }
    },
