      }
    },
    "diagnostics.finding.storage.smart": {
      "comment": "Storage check: SMART wear data exists but is deliberately unread",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive keeps its own record of how much of its rated life it has used. Reading it needs a privilege Boreas does not ask for, so that figure is not shown here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco lleva su propio registro de cuánta de su vida útil ha consumido. Leerlo requiere un privilegio que Boreas no pide, así que esa cifra no se muestra aquí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск сам ведёт учёт того, какую часть расчётного ресурса он израсходовал. Чтение этих данных требует прав, которых Boreas не запрашивает, поэтому здесь это значение не показано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk, ömrünün ne kadarını kullandığını kendisi kaydeder. Bunu okumak Boreas'ın istemediği bir yetki gerektirir, bu yüzden o değer burada gösterilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘会自己记录已经用掉多少额定寿命。读取这项数据需要 Boreas 不会申请的权限，因此这里不显示该数值。"
          }
        }
      }
    },
    "diagnostics.finding.storage.unreadable": {
      "comment": "Storage check: capacity could not be read",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system did not report the drive's capacity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema no ha informado de la capacidad del disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система не сообщила ёмкость диска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem diskin kapasitesini bildirmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有报告磁盘容量。"
          }
        }
      }
    },
    "diagnostics.finding.thermal.calm": {
      "comment": "Thermal history check: the system never reported pressure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system reported no thermal pressure this session. Peak temperature: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta sesión el sistema no ha informado de presión térmica. Temperatura máxima: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом сеансе система не сообщала о тепловом давлении. Пиковая температура: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem bu oturumda termal baskı bildirmedi. En yüksek sıcaklık: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话中系统没有报告散热压力。最高温度：%@。"
          }
        }
      }
    },
    "diagnostics.finding.thermal.nopeak": {
      "comment": "Stands in for a peak temperature that was never recorded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not recorded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sin registrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "не записано"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kaydedilmedi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录"
          }
        }
      }
    },
    "diagnostics.finding.thermal.pressure": {
      "comment": "Thermal history check: the system reported pressure during the session",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system reported serious pressure for %lld s and critical pressure for %lld s this session. Peak temperature: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta sesión el sistema informó de presión grave durante %1$lld s y crítica durante %2$lld s. Temperatura máxima: %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом сеансе система сообщала о серьёзном давлении %1$lld с и о критическом %2$lld с. Пиковая температура: %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem bu oturumda %lld sn ciddi, %lld sn kritik baskı bildirdi. En yüksek sıcaklık: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话中系统报告了 %1$lld 秒的 serious 压力和 %2$lld 秒的 critical 压力。最高温度：%3$@。"
          }
        }
      }
    },
    "diagnostics.finding.thermal.short": {
      "comment": "Thermal history check: not enough time observed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is too short to say anything about thermal history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión es demasiado corta para decir nada del historial térmico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс слишком короткий, чтобы говорить об истории нагрева."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum, termal geçmiş hakkında bir şey söyleyemeyecek kadar kısa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话太短，无法对散热历史作出判断。"
          }
        }
      }
    },
    "diagnostics.honesty": {
      "comment": "States plainly what the diagnostics can and cannot know",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are observations, not verdicts. Boreas can measure what the hardware reports; it cannot see inside your Mac, so it never tells you something is faulty — it tells you what it measured and what could explain it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son observaciones, no veredictos. Boreas puede medir lo que informa el hardware; no puede ver dentro de tu Mac, así que nunca te dice que algo esté mal: te dice qué ha medido y qué podría explicarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это наблюдения, а не заключения. Boreas может измерить то, о чём сообщает оборудование; он не видит, что внутри вашего Mac, и поэтому никогда не утверждает, что что-то неисправно, — он сообщает, что измерил и чем это можно объяснить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar gözlem, hüküm değil. Boreas donanımın bildirdiğini ölçebilir; Mac'inizin içini göremez. Bu yüzden size bir şeyin arızalı olduğunu asla söylemez — ne ölçtüğünü ve bunu nelerin açıklayabileceğini söyler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是观察结果，不是结论。Boreas 只能测量硬件所报告的内容；它看不到你 Mac 的内部，所以它从不断言某个部件有问题——它只告诉你测到了什么，以及可能的解释。"
          }
        }
      }
    },
    "diagnostics.logs.detail": {
      "comment": "Says how many recordings exist and that they stay local",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld recording file(s) on this Mac, %lld MB. Nothing is sent anywhere; recording is switched on in Settings and off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de grabación en este Mac: %1$lld, %2$lld MB. No se envía nada a ningún sitio; la grabación se activa en Ajustes y está desactivada por omisión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлов записи на этом Mac: %1$lld, %2$lld МБ. Ничего никуда не отправляется; запись включается в настройках и по умолчанию выключена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te %1$lld kayıt dosyası var, %2$lld MB. Hiçbir şey hiçbir yere gönderilmez; kayıt Ayarlar'dan açılır ve varsayılan olarak kapalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上有 %1$lld 个记录文件，共 %2$lld MB。不会发送到任何地方；记录在设置中开启，默认关闭。"
          }
        }
      }
    },
    "diagnostics.logs.reveal": {
      "comment": "Button opening the recordings folder from diagnostics",
      "extractionState": "manual",
