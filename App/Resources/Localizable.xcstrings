    "control.safety.k5.detail": {
      "comment": "What safety chain layer K5 does, with the permitted timeout range",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No heartbeat for %lld to %lld seconds hands the fans back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no hay señal durante %1$lld a %2$lld segundos, los ventiladores vuelven al firmware."
