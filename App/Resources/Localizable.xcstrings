    "settings.advanced.transfer.help": {
      "comment": "Explains that import is validated exactly like a normal load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An imported file goes through the same checks as one found at startup, including migration from an older version. A file that fails them changes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo importado pasa las mismas comprobaciones que uno encontrado al arrancar, incluida la migración desde una versión anterior. Un archivo que no las pase no cambia nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированный файл проходит те же проверки, что и найденный при запуске, включая обновление со старой версии. Файл, не прошедший их, ничего не меняет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan dosya, açılışta bulunan bir dosyayla aynı denetimlerden geçer; eski sürümden yükseltme dahil. Bu denetimleri geçemeyen dosya hiçbir şeyi değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的文件会经过与启动时相同的检查，包括从旧版本的迁移。没有通过检查的文件不会改变任何东西。"
          }
        }
      }
    },
