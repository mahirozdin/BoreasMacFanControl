          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые датчики не менялись весь сеанс: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sensörler oturum boyunca hiç değişmedi: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些传感器在整个会话中都没有变化：%@。"
          }
        }
      }
    },
    "diagnostics.finding.sensors.unreadable": {
      "comment": "Sensor validity check: nothing to judge",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sensor is being read right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se está leyendo ningún sensor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не читается ни один датчик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda okunan sensör yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有读取到任何传感器。"
          }
        }
      }
    },
    "diagnostics.finding.storage.full": {
      "comment": "Storage check: very little free space, which also warms the drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive has only %lld%% of its space free, and its sensors report %lld °C. A drive with little room left works harder and runs warmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al disco solo le queda libre el %1$lld%% y sus sensores informan %2$lld °C. Un disco con poco espacio trabaja más y se calienta más."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На диске свободно лишь %1$lld%%, датчики показывают %2$lld °C. Диску с малым запасом места приходится работать больше, и он греется сильнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskin alanının yalnızca %1$lld%%'i boş ve sensörleri %2$lld °C bildiriyor. Yeri azalan bir disk daha çok çalışır ve daha çok ısınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘只剩 %1$lld%% 的可用空间，其传感器报告 %2$lld °C。剩余空间很少的磁盘要做更多工作，也会更热。"
          }
        }
      }
    },
    "diagnostics.finding.storage.full.nosensor": {
      "comment": "Storage check: very little free space, no storage sensor",
      "extractionState": "manual",
      "localizations": {
        "en": {
