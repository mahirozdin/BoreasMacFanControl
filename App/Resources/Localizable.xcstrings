    "control.mapping.accessibility": {
      "comment": "VoiceOver label of one fan-to-sensor-group mapping row in the control tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ follows %@, %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sigue a %2$@, %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ следует за %2$@, %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ şunu izliyor: %2$@, %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 跟随 %2$@，%3$@"
          }
        }
      }
    },
    "control.mapping.nofans": {
      "comment": "Shown in the fan mapping list on a machine with no fans",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac reports no controllable fan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no informa de ningún ventilador controlable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не сообщает об управляемых вентиляторах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac denetlenebilir bir fan bildirmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 未报告可控风扇。"
          }
        }
