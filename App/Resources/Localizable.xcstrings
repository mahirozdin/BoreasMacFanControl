      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünür"
          }
        }
      }
    },
    "settings.shortcuts.clear": {
      "comment": "Tooltip of the button that clears a shortcut",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this shortcut"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayolu kaldır"
          }
        }
      }
    },
    "settings.shortcuts.help": {
      "comment": "Explains what global shortcuts are and their one limitation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These work anywhere, without Boreas being frontmost, and without any accessibility permission. A combination another application already holds cannot be taken, and Boreas says so rather than doing nothing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar her yerde çalışır; Boreas'ın önde olması gerekmez ve hiçbir erişilebilirlik izni istenmez. Başka bir uygulamanın tuttuğu bir kombinasyon alınamaz ve Boreas bunu sessizce geçmek yerine söyler."
          }
        }
      }
    },
    "settings.shortcuts.needsmodifier": {
      "comment": "Shown when a recorded combination has no qualifying modifier",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "add ⌘, ⌥ or ⌃"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ ya da ⌃ ekleyin"
          }
        }
      }
    },
    "settings.shortcuts.recording": {
      "comment": "Placeholder while a shortcut is being recorded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press keys…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlara basın…"
          }
        }
      }
    },
    "settings.shortcuts.refused": {
      "comment": "Shown when the system refused to register a shortcut",
      "extractionState": "manual",
      "localizations": {
