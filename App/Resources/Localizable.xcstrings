        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra Boreas como ítem de inicio. macOS lo muestra en Ítems de inicio, donde también se puede desactivar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрирует Boreas как объект входа. macOS показывает его в списке объектов входа, где его можно и отключить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boreas'ı bir giriş öğesi olarak kaydeder. macOS bunu Giriş Öğeleri altında gösterir; oradan kapatılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Boreas 注册为登录项。macOS 会在“登录项”中显示它，也可以在那里关闭。"
          }
        }
      }
    },
