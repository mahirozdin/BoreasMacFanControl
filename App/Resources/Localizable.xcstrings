        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "вентиляторы остаются за прошивкой"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fanları donanım yazılımı tutar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇仍由固件控制"
          }
        }
      }
    },
    "settings.control.panic": {
      "comment": "Setting: the K3 trigger temperature",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panic threshold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbral de emergencia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварийный порог"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panik eşiği"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧急阈值"
          }
        }
      }
    },
    "settings.control.panic.help": {
      "comment": "Explains the panic threshold and why it cannot be raised",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above this, every fan goes to full speed and holds there. It can be lowered, never raised above the default — the ceiling is the default (ADR 0022)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de esto, todos los ventiladores van a velocidad máxima y se mantienen ahí. Se puede bajar, pero nunca subir por encima del valor por omisión: el techo es ese valor (ADR 0022)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выше этого значения все вентиляторы выходят на полную скорость и удерживают её. Его можно понизить, но никогда не поднять выше значения по умолчанию — потолком является само значение по умолчанию (ADR 0022)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun üstünde her fan tam hıza çıkar ve orada kalır. Aşağı çekilebilir, varsayılanın üstüne çıkarılamaz — tavan, varsayılanın kendisidir (ADR 0022)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过这个温度，所有风扇都会全速运转并保持。它可以调低，但绝不能调到高于默认值——上限就是默认值（ADR 0022）。"
          }
        }
      }
    },
    "settings.control.section.profiles": {
      "comment": "Settings section heading: the profile list and default",
      "extractionState": "manual",
      "localizations": {
