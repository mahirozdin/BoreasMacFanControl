    "notify.daemon.body": {
      "comment": "Notification body for the daemon connection lost trigger",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans are back under the system's control. Nothing is at risk — this is what is supposed to happen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores vuelven a estar bajo el control del sistema. No hay nada en riesgo: esto es justo lo que debe pasar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы снова под управлением системы. Ничего не под угрозой — так и должно быть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar yeniden sistemin denetiminde. Bir risk yok — olması gereken tam olarak bu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇已交回系统控制。没有任何风险——这本来就是应该发生的事。"
          }
        }
      }
    },
    "notify.daemon.title": {
      "comment": "Notification title: the helper connection dropped or the watchdog fired",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan control handed back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control de ventiladores devuelto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление вентиляторами возвращено"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan denetimi sisteme geri verildi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇控制已交回"
          }
        }
      }
    },
    "notify.fan.body": {
      "comment": "Notification body for the fan anomaly trigger",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans are not following their targets as closely as expected. Diagnostics has the details and some things to try."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores no siguen sus objetivos tan de cerca como se esperaba. En Diagnóstico están los detalles y algunas cosas que probar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы следуют цели не так точно, как ожидалось. Подробности и что можно попробовать — в разделе диагностики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar hedeflerini beklendiği kadar yakın izlemiyor. Tanılama bölümünde ayrıntılar ve denenebilecek birkaç şey var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇跟随目标转速的贴合程度不如预期。诊断中有详细信息和一些可以尝试的做法。"
          }
        }
      }
    },
    "notify.fan.title": {
      "comment": "Notification title: a fan check raised a concern",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fan check is worth a look"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación de ventiladores merece un vistazo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка вентиляторов: стоит посмотреть"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fan kontrolü bakmaya değer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇检查值得看一下"
          }
        }
      }
    },
    "notify.panic.body": {
      "comment": "Notification body for the panic layer trigger",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensor crossed the panic threshold, so the fans are at full speed until it falls back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sensor ha cruzado el umbral de emergencia, así que los ventiladores están a velocidad máxima hasta que vuelva a bajar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчик превысил аварийный порог, поэтому вентиляторы работают на полной скорости, пока значение не опустится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sensör panik eşiğini geçti; eşiğin altına düşene kadar fanlar tam hızda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有传感器超过了紧急阈值，因此风扇会全速运转，直到温度回落。"
          }
        }
      }
    },
    "notify.panic.title": {
      "comment": "Notification title: the panic layer engaged",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cooling at full speed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refrigerando a velocidad máxima"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Охлаждение на полной скорости"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam hızda soğutma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在全速散热"
          }
        }
      }
    },
    "notify.profile.body": {
      "comment": "Notification body naming the profile that became active",
      "extractionState": "manual",
      "localizations": {
        "en": {
