    "settings.advanced.reset.help": {
      "comment": "Explains what resetting to defaults does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores every setting, profile and curve to the built-in defaults. The previous file is kept as config.backup.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos los ajustes, perfiles y curvas a los valores integrados. El archivo anterior se conserva como config.backup.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает все настройки, профили и кривые к встроенным значениям. Предыдущий файл сохраняется как config.backup.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayarı, profili ve eğriyi yerleşik varsayılanlara döndürür. Önceki dosya config.backup.json olarak saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把所有设置、方案和曲线恢复为内置默认值。之前的文件会保留为 config.backup.json。"
          }
        }
      }
    },
