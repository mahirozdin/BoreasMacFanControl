    "settings.appearance.compact.help": {
      "comment": "Explains compact mode",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact drops the degree marks and tightens the spacing, which is what to reach for when the menu bar runs out of room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo compacto quita los símbolos de grado y aprieta el espaciado; es lo que conviene cuando la barra de menús se queda sin sitio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактный режим убирает знаки градуса и уплотняет отступы — то, к чему стоит обратиться, когда в строке меню кончается место."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkışık kip derece işaretlerini atar ve aralıkları daraltır; menü çubuğunda yer kalmadığında başvurulacak ayar budur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑模式会去掉度数符号并收紧间距，菜单栏位置不够时正适合用它。"
          }
        }
      }
    },
