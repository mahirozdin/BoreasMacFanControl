    "settings.record.ceiling": {
      "comment": "Label of the recording disk ceiling stepper",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use more than"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No usar más de"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать не более"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılacak en fazla alan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多占用"
          }
        }
      }
    },
    "settings.record.ceiling.note": {
      "comment": "Explains that the disk ceiling overrides the retention setting",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This limit wins over the one above it. If recordings reach it, the oldest are deleted even when they are newer than the retention period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este límite manda sobre el anterior. Si las grabaciones lo alcanzan, se borran las más antiguas aunque sean más recientes que el periodo de conservación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот предел важнее предыдущего. Если записи достигнут его, самые старые будут удалены, даже если они новее срока хранения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sınır üstündekine üstün gelir. Kayıtlar bu boyuta ulaşırsa, saklama süresinden daha yeni olsalar bile en eskiler silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个限制优先于上面那一项。如果记录文件达到它，即使比保留期限更新，最旧的文件也会被删除。"
          }
        }
      }
    },
