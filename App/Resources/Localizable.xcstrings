    "settings.notify.panic.note": {
      "comment": "Notification settings: why the panic trigger cannot be switched off",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on, like the panic threshold itself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre activo, igual que el propio umbral de emergencia"
          }
        },
