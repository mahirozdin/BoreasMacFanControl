    "settings.notify.permission.denied": {
      "comment": "Shown when the system has refused the notification permission",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is not allowing notifications from Boreas. You can change that in System Settings, under Notifications."
