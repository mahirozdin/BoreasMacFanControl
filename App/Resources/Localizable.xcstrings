          }
        }
      }
    },
    "control.mapping.accessibility": {
      "comment": "VoiceOver label of one fan-to-sensor-group mapping row in the control tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ follows %@, %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ şunu izliyor: %2$@, %3$@"
          }
        }
      }
    },
    "control.mapping.nofans": {
      "comment": "Shown in the fan mapping list on a machine with no fans",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac reports no controllable fan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac denetlenebilir bir fan bildirmiyor."
          }
        }
      }
    },
    "control.override.duration": {
      "comment": "Label of the manual override duration picker",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre"
          }
        }
      }
    },
    "control.override.forever": {
      "comment": "Manual override duration choice with no time limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until I stop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben durdurana kadar"
          }
        }
      }
    },
    "control.override.indefinite": {
      "comment": "Caption while an open-ended manual override is running",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are driving the fans until you hand them back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanları siz sürüyorsunuz; direksiyonu bırakana kadar böyle kalır."
          }
        }
      }
    },
    "control.override.minutes": {
      "comment": "Manual override duration choice in minutes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika"
          }
        }
      }
    },
    "control.override.start": {
      "comment": "Button that starts driving the fans at the slider value",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take Over"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devral"
          }
        }
      }
    },
    "control.override.stop": {
      "comment": "Button that hands control back to the curve engine",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Automatic"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatiğe Dön"
          }
        }
      }
    },
    "control.override.until": {
      "comment": "Caption while a timed manual override is running",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to automatic at %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatiğe dönüş: %@"
          }
        }
      }
    },
    "control.safety.acting": {
      "comment": "Status of a safety chain layer that is currently overriding the output",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acting now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "şu an müdahale ediyor"
          }
        }
      }
    },
    "control.safety.armed": {
      "comment": "Status of a safety chain layer that is active but not intervening",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "armed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kurulu"
          }
        }
      }
    },
    "control.safety.k1": {
      "comment": "Safety chain layer K1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — Fan floor"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — Fan tabanı"
          }
        }
      }
    },
    "control.safety.k1.detail": {
      "comment": "What safety chain layer K1 does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output never goes below the hardware minimum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış hiçbir zaman donanım alt sınırının altına inmez."
          }
        }
      }
    },
    "control.safety.k2": {
      "comment": "Safety chain layer K2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — Thermal state"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — Termal durum"
          }
        }
      }
    },
    "control.safety.k2.detail": {
      "comment": "What safety chain layer K2 does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serious raises the floor to 55%, critical forces 100%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciddi durumda taban %55'e çıkar, kritik durumda %100 zorlanır."
          }
        }
      }
    },
    "control.safety.k3": {
      "comment": "Safety chain layer K3",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K3 — Panic threshold"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K3 — Panik eşiği"
          }
        }
      }
    },
    "control.safety.k3.detail": {
      "comment": "What safety chain layer K3 does, with the threshold temperature",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above %lld °C: full speed, held for 30 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld °C üstünde: tam hız, 30 saniye kilitli."
          }
        }
      }
    },
    "control.safety.k4": {
      "comment": "Safety chain layer K4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K4 — Helper guard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K4 — Yardımcı süzgeci"
          }
        }
      }
    },
    "control.safety.k4.detail": {
      "comment": "What safety chain layer K4 does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper refuses any speed the hardware does not accept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı, donanımın kabul etmediği hiçbir hızı geçirmez."
          }
        }
      }
    },
    "control.safety.k5": {
      "comment": "Safety chain layer K5",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K5 — Watchdog"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K5 — Watchdog"
          }
        }
      }
    },
    "control.safety.k5.detail": {
      "comment": "What safety chain layer K5 does, with the permitted timeout range",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No heartbeat for %lld to %lld seconds hands the fans back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld saniye kalp atışı gelmezse fanlar geri verilir."
          }
        }
      }
    },
    "control.section.mapping": {
      "comment": "Heading of the per-fan sensor mapping list in the control tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan inputs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan girişleri"
          }
        }
      }
    },
    "control.section.override": {
      "comment": "Heading of the manual fan override section in the control tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual override"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle devralma"
          }
        }
      }
    },
    "control.section.safety": {
      "comment": "Heading of the safety chain status list in the control tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety chain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik zinciri"
          }
        }
      }
    },
    "control.why.fallback": {
      "comment": "Explains that the default profile is active by fallback",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is active because no other profile's condition holds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ etkin, çünkü başka hiçbir profilin koşulu sağlanmıyor."
          }
        }
      }
    },
    "control.why.manual": {
      "comment": "Explains that the active profile was chosen by the user",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is active because you selected it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ etkin, çünkü onu siz seçtiniz."
          }
        }
      }
    },
    "control.why.manual.timed": {
      "comment": "Explains a user-selected profile that expires at a given time",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is active because you selected it, until %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ etkin, çünkü onu siz seçtiniz. Bitiş: %@"
          }
        }
      }
    },
    "control.why.none": {
      "comment": "Shown in the control tab when there is no profile to activate",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profile is configured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanımlı profil yok."
          }
        }
      }
    },
    "control.why.trigger": {
      "comment": "Explains which trigger condition activated the profile",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is active because %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ etkin, çünkü %@."
          }
        }
      }
    },
    "curve.accessibility.point": {
      "comment": "One curve control point read aloud: its number, temperature and duty",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %lld, %lld degrees, %lld percent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. nokta, %2$lld derece, yüzde %3$lld"
          }
        }
      }
    },
    "curve.editor.accessibility": {
      "comment": "VoiceOver label for the curve editor plot",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan curve editor"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan eğrisi düzenleyici"
          }
        }
      }
    },
    "curve.editor.accessibility.hint": {
      "comment": "VoiceOver hint pointing from the curve plot to its numeric table",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the point table below to edit the curve"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğriyi düzenlemek için aşağıdaki nokta tablosunu kullanın"
          }
        }
      }
    },
    "curve.hint": {
      "comment": "One-line instructions under the curve editor",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a point to reshape · double-click to add · right-click a point to remove"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noktayı sürükleyerek eğriyi değiştirin · çift tıkla ekleyin · noktaya sağ tıklayıp silin"
          }
        }
      }
    },
    "curve.none": {
      "comment": "Shown in the curve editor when no profile is active",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profile is active, so there is no curve to edit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin profil yok, dolayısıyla düzenlenecek eğri de yok."
