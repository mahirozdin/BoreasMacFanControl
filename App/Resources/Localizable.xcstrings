    },
    "setup.reinstall.button": {
      "comment": "Button that reinstalls the helper after a removal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Kur"
          }
        }
      }
    },
    "setup.remove.button": {
      "comment": "Button that unregisters the privileged helper",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır…"
          }
        }
      }
    },
    "setup.removed": {
      "comment": "Confirmation after the helper was unregistered",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper removed. The background item is gone and the firmware controls the fans."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı kaldırıldı. Arka plan öğesi gitti; fanları donanım yazılımı yönetiyor."
          }
        }
      }
    },
    "setup.retry.button": {
      "comment": "Button that retries the helper installation after a failure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Dene"
          }
        }
      }
    },
    "setup.skip.note": {
      "comment": "Reassurance under the setup actions; installing is optional (invariant I4)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this entirely. Without the helper, Boreas remains a fully working temperature monitor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu tümüyle atlayabilirsiniz. Yardımcı olmadan da Boreas tam çalışan bir sıcaklık izleyicisi olarak kalır."
          }
        }
      }
    },
    "setup.title": {
      "comment": "Title inside the helper setup window",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Control Setup"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Kontrolü Kurulumu"
          }
        }
      }
    },
    "setup.undo.button": {
      "comment": "Setup bullet: removal routes offered by the product",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Remove button on this screen unregisters the helper. The Terminal command “boreas uninstall --all” does the same and also deletes saved settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekrandaki Kaldır düğmesi yardımcının kaydını siler. Terminal'deki “boreas uninstall --all” komutu aynısını yapar, üstelik kayıtlı ayarları da siler."
          }
        }
      }
    },
    "setup.undo.firmware": {
      "comment": "Setup bullet: System Settings route and the firmware fallback guarantee (G4)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also switch the item off in System Settings. The moment the helper is gone, the firmware controls the fans again — that is the safe state."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeyi Sistem Ayarları'ndan da kapatabilirsiniz. Yardımcı gittiği anda fanları yeniden donanım yazılımı yönetir — güvenli durum budur."
          }
        }
      }
    },
    "setup.undo.heading": {
      "comment": "Heading of the setup section explaining removal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to undo it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri alma yolu"
          }
        }
      }
    },
    "setup.verifying": {
      "comment": "Progress text while the app proves the helper connection end to end",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying the connection…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı doğrulanıyor…"
          }
        }
      }
    },
    "setup.what.admin": {
      "comment": "Setup bullet: single administrator approval (invariant I3)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks an administrator to approve the helper — once. Boreas never sees the password."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yardımcıyı onaylaması için bir yöneticiye sorar — bir kez. Boreas parolayı hiçbir zaman görmez."
          }
        }
      }
    },
    "setup.what.heading": {
      "comment": "Heading of the setup section explaining the effects of installing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will happen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olacak"
          }
        }
      }
    },
    "setup.what.helper": {
      "comment": "Setup bullet: what the privileged helper is",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A helper service is registered. It runs with root privileges and is started by macOS on demand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yardımcı servis kaydedilir. Root yetkisiyle çalışır ve macOS tarafından gerektiğinde başlatılır."
          }
        }
      }
    },
    "setup.what.surface": {
      "comment": "Setup bullet: the helper's deliberately narrow surface (invariants M4-M6)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper only reads fan state and writes fan speeds within hardware limits. It accepts no files or commands and never touches the network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı yalnızca fan durumunu okur ve donanım sınırları içinde fan hızı yazar. Hiçbir dosya ya da komut kabul etmez, ağa hiç dokunmaz."
          }
        }
      }
    },
    "setup.window.title": {
      "comment": "Title of the fan control setup window",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Control"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Kontrolü"
          }
        }
      }
