    "trigger.none.help": {
      "comment": "Explains what having no trigger means for a profile",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no trigger, this profile is reachable only by choosing it, or as the default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin activador, este perfil solo se alcanza eligiéndolo, o como perfil por omisión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без триггера этот профиль доступен только выбором вручную или как профиль по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetikleyici yoksa bu profile yalnızca onu seçerek ya da varsayılan olarak ulaşılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有触发条件时，这个方案只能通过手动选择，或作为默认方案来使用。"
          }
        }
      }
    },
