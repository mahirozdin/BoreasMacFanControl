    "settings.control.default.help": {
      "comment": "Explains what the default profile is for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when no trigger holds and nothing is selected by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando no se cumple ningún activador y no hay nada elegido a mano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда ни один триггер не выполняется и ничего не выбрано вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir tetikleyici sağlanmadığında ve elle bir seçim yapılmadığında kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有触发条件成立、也没有手动选择时使用。"
          }
        }
      }
    },
