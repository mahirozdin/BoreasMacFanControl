    "settings.record.state.ceiling": {
      "comment": "Shown when the disk ceiling has had to delete recordings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size limit has deleted %lld file(s) this session. Raise the limit or shorten the retention period to keep more."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El límite de tamaño ha borrado %lld archivo en esta sesión. Sube el límite o acorta el periodo de conservación para guardar más."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El límite de tamaño ha borrado %lld archivos en esta sesión. Sube el límite o acorta el periodo de conservación para guardar más."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предел размера удалил в этом сеансе %lld файла. Чтобы хранить больше, поднимите предел или сократите срок хранения."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предел размера удалил в этом сеансе %lld файлов. Чтобы хранить больше, поднимите предел или сократите срок хранения."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предел размера удалил в этом сеансе %lld файл. Чтобы хранить больше, поднимите предел или сократите срок хранения."
                }
              },
              "other": {
