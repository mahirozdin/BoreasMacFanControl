    "setup.skip.note": {
      "comment": "Reassurance under the setup actions; installing is optional (invariant I4)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this entirely. Without the helper, Boreas remains a fully working temperature monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes saltarte esto por completo. Sin el asistente, Boreas sigue siendo un monitor de temperatura perfectamente funcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно полностью пропустить. Без службы Boreas остаётся полностью работающим монитором температуры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu tümüyle atlayabilirsiniz. Yardımcı olmadan da Boreas tam çalışan bir sıcaklık izleyicisi olarak kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你完全可以跳过这一步。没有辅助程序，Boreas 仍是一个完整可用的温度监视器。"
          }
        }
      }
    },
    "setup.title": {
      "comment": "Title inside the helper setup window",
      "extractionState": "manual",
      "localizations": {
        "en": {
