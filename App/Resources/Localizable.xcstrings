    "settings.record.note": {
      "comment": "Explains that recording is local only and off by default",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off unless you ask for it. Every sample is written locally and nothing is ever sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado salvo que lo pidas. Cada muestra se escribe en local y nunca se envía nada a ningún sitio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено, пока вы не попросите. Каждое измерение пишется локально, и ничего никуда не отправляется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemedikçe kapalı. Her örnek yerel olarak yazılır ve hiçbir şey hiçbir yere gönderilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你要求，否则保持关闭。每次采样都写在本地，绝不会发送到任何地方。"
          }
        }
      }
    },
