    "settings.record.format.csv.note": {
      "comment": "Explains what the CSV recording format is good for and its limitation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens directly in a spreadsheet. The columns are fixed when a file starts, so a sensor that appears later in the day is not in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre directamente en una hoja de cálculo. Las columnas se fijan al empezar el archivo, así que un sensor que aparezca más tarde ese día no estará en él."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается прямо в таблице. Столбцы фиксируются при создании файла, поэтому датчик, появившийся позже в тот же день, в него не попадёт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan hesap tablosunda açılır. Sütunlar dosya başlarken sabitlenir; gün içinde sonradan görünen bir sensör o dosyada yer almaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接在电子表格中打开。列在文件创建时就固定下来，因此当天之后才出现的传感器不会包含在内。"
          }
        }
      }
    },
