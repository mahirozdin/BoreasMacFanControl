    "diagnostics.finding.battery.absent": {
      "comment": "Battery check on a desktop: a complete answer, not a gap",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no battery, so there is nothing to report here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene batería, así que aquí no hay nada que informar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом Mac нет батареи, поэтому сообщать здесь нечего."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te pil yok, dolayısıyla burada bildirilecek bir şey yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没有电池，因此这里没有可报告的内容。"
          }
        }
      }
    },
    "diagnostics.finding.battery.healthy": {
      "comment": "Battery check: cycles and capacity, both unremarkable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery has been through %lld charge cycles and holds %lld%% of the charge it was built to hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos de carga completados: %1$lld. La batería retiene el %2$lld%% de la carga para la que se fabricó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циклов заряда пройдено: %1$lld. Батарея держит %2$lld%% от заряда, на который была рассчитана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld şarj döngüsünden geçti ve üretildiğinde taşıdığı şarjın %2$lld%%'ini tutuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池已完成 %1$lld 次充电循环，可储存出厂设计电量的 %2$lld%%。"
          }
        }
      }
    },
    "diagnostics.finding.battery.unreadable": {
      "comment": "Battery check: the reading did not come back",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system did not report any battery figures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema no ha informado de ninguna cifra de la batería."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система не сообщила никаких данных о батарее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem herhangi bir pil değeri bildirmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有报告任何电池数据。"
          }
        }
      }
    },
    "diagnostics.finding.battery.warm": {
      "comment": "Battery check: the battery is running warm",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery is at %lld °C — warm for a battery. %lld charge cycles, holding %lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está a %1$lld °C, temperatura alta para una batería. Ciclos de carga: %2$lld, retiene el %3$lld%%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура батареи %1$lld °C — для батареи это тепло. Циклов заряда: %2$lld, держит %3$lld%%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %1$lld °C — bir pil için sıcak sayılır. %2$lld şarj döngüsü, tuttuğu şarj %3$lld%%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度为 %1$lld °C——对电池来说偏高。已完成 %2$lld 次充电循环，可储存 %3$lld%%。"
          }
        }
      }
    },
    "diagnostics.finding.battery.worn": {
      "comment": "Battery check: capacity has fallen below the rated service level",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %lld charge cycles the battery holds %lld%% of the charge it was built to hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos de carga completados: %1$lld. La batería retiene el %2$lld%% de la carga para la que se fabricó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циклов заряда пройдено: %1$lld. Батарея держит %2$lld%% от заряда, на который была рассчитана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld şarj döngüsünden sonra pil, üretildiğinde taşıdığı şarjın %2$lld%%'ini tutuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过 %1$lld 次充电循环后，电池可储存出厂设计电量的 %2$lld%%。"
          }
        }
      }
    },
    "diagnostics.finding.response.deviating": {
      "comment": "Fan response check: the fans are not following their commands closely",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans sat %lld rpm from their target on average, and as much as %lld rpm away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores se quedaron a %1$lld rpm de su objetivo de media, y hasta %2$lld rpm en el peor caso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы в среднем отклонялись от цели на %1$lld об/мин, максимум на %2$lld об/мин."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar hedeflerinden ortalama %lld dev/dk, en fazla da %lld dev/dk uzakta kaldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇与目标转速平均相差 %1$lld 转/分，最大相差 %2$lld 转/分。"
          }
        }
      }
    },
    "diagnostics.finding.response.nodata": {
      "comment": "Fan response check: not enough evidence yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans have not been driven long enough this session to judge how they respond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta sesión los ventiladores no han funcionado el tiempo suficiente para juzgar cómo responden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом сеансе вентиляторы работали слишком недолго, чтобы судить об отклике."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar bu oturumda, nasıl yanıt verdiklerine hükmedilecek kadar uzun sürülmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话中风扇运转的时间还不足以判断它们的响应情况。"
          }
        }
      }
    },
    "diagnostics.finding.response.tracking": {
      "comment": "Fan response check: the fans are following their commands",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans followed their targets to within %lld rpm on average."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores siguieron sus objetivos con un margen medio de %lld rpm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы следовали цели в среднем с точностью %lld об/мин."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar hedeflerini ortalama %lld dev/dk yaklaşıklıkla izledi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇跟随目标转速的平均误差在 %lld 转/分以内。"
          }
        }
      }
    },
    "diagnostics.finding.sensors.both": {
      "comment": "Sensor validity check: both out of range and unmoving readings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sensors are reporting oddly — outside anything physical: %@; unchanged all session: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos sensores informan de forma extraña: fuera de lo físicamente posible: %1$@; sin cambios en toda la sesión: %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые датчики сообщают странное — вне физически возможного: %1$@; без изменений весь сеанс: %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sensörler tuhaf bildiriyor — fiziksel olmayan değerler: %@; oturum boyunca hiç değişmeyenler: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些传感器的读数不太正常——超出物理可能范围：%1$@；整个会话都没有变化：%2$@。"
          }
        }
      }
    },
    "diagnostics.finding.sensors.healthy": {
      "comment": "Sensor validity check: every sensor looks normal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld sensors are reporting plausible, changing values."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El único sensor, %lld, informa valores plausibles y cambiantes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los %lld sensores informan valores plausibles y cambiantes."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Все %lld датчика сообщают правдоподобные, меняющиеся значения."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Все %lld датчиков сообщают правдоподобные, меняющиеся значения."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Все %lld датчик сообщает правдоподобные, меняющиеся значения."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Все %lld датчиков сообщают правдоподобные, меняющиеся значения."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sensörün tamamı makul ve değişen değerler bildiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部 %lld 个传感器都在报告合理且有变化的数值。"
          }
        }
      }
    },
    "diagnostics.finding.sensors.outofrange": {
      "comment": "Sensor validity check: readings outside the plausible range",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
