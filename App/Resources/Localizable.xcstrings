            "state": "translated",
            "value": "%lld °C için %%%lld"
          }
        }
      }
    },
    "curve.redo": {
      "comment": "Tooltip of the curve editor redo button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo"
          }
        },
