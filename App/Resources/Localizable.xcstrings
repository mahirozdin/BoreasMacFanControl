      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper removed. The background item is gone and the firmware controls the fans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistente quitado. El ítem en segundo plano ha desaparecido y el firmware controla los ventiladores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба удалена. Фоновый объект исчез, и вентиляторами управляет прошивка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
