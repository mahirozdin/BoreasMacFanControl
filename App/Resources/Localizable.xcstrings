    "settings.shortcuts.help": {
      "comment": "Explains what global shortcuts are and their one limitation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These work anywhere, without Boreas being frontmost, and without any accessibility permission. A combination another application already holds cannot be taken, and Boreas says so rather than doing nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionan en cualquier sitio, sin que Boreas esté en primer plano y sin ningún permiso de accesibilidad. Una combinación que ya tenga otra aplicación no se puede tomar, y Boreas lo dice en lugar de no hacer nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они работают везде, без того чтобы Boreas был активным приложением, и без каких-либо разрешений на управление компьютером. Сочетание, которое уже занято другим приложением, занять нельзя, и Boreas говорит об этом, а не молчит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar her yerde çalışır; Boreas'ın önde olması gerekmez ve hiçbir erişilebilirlik izni istenmez. Başka bir uygulamanın tuttuğu bir kombinasyon alınamaz ve Boreas bunu sessizce geçmek yerine söyler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们在任何地方都有效，不需要 Boreas 处于最前面，也不需要任何辅助功能权限。已被其他应用占用的组合无法获取，Boreas 会直接说明，而不是什么都不做。"
          }
        }
      }
    },
    "settings.shortcuts.needsmodifier": {
      "comment": "Shown when a recorded combination has no qualifying modifier",
      "extractionState": "manual",
      "localizations": {
