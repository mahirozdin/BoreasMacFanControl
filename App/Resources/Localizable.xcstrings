          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На диске свободно %1$lld%%, датчики показывают %2$lld °C."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskin alanının %1$lld%%'i boş ve sensörleri %2$lld °C bildiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘有 %1$lld%% 的可用空间，其传感器报告 %2$lld °C。"
          }
        }
      }
    },
    "diagnostics.finding.storage.healthy.nosensor": {
      "comment": "Storage check: free space, on a Mac with no storage sensor",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive has %lld%% of its space free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al disco le queda libre el %lld%%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
