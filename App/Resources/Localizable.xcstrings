          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuración se ha actualizado desde la versión %lld. El original está al lado como config.backup.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти настройки обновлены с версии %lld. Исходный файл лежит рядом как config.backup.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
