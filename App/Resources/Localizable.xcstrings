    "control.safety.k1": {
      "comment": "Safety chain layer K1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — Fan floor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — Mínimo del ventilador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — нижний предел"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — Fan tabanı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "K1 — 风扇下限"
          }
        }
      }
    },
    "control.safety.k1.detail": {
      "comment": "What safety chain layer K1 does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output never goes below the hardware minimum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida nunca baja del mínimo del hardware."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость никогда не опускается ниже аппаратного минимума."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış hiçbir zaman donanım alt sınırının altına inmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出永不低于硬件最低转速。"
          }
        }
      }
    },
    "control.safety.k2": {
      "comment": "Safety chain layer K2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — Thermal state"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — Estado térmico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — тепловое состояние"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — Termal durum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 — 散热状态"
          }
        }
      }
    },
    "control.safety.k2.detail": {
      "comment": "What safety chain layer K2 does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serious raises the floor to 55%, critical forces 100%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Serious» sube el mínimo al 55%; «critical» fuerza el 100%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
