    "setup.approval.explain": {
      "comment": "Shown while the background item waits for approval in System Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your approval in System Settings. Boreas notices by itself once you allow it — leave this window open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS está esperando tu aprobación en Ajustes del Sistema. Boreas se dará cuenta por sí solo en cuanto lo permitas; deja esta ventana abierta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ждёт вашего разрешения в Системных настройках. Boreas заметит это сам, как только вы разрешите — оставьте это окно открытым."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Sistem Ayarları'nda onayınızı bekliyor. İzin verdiğiniz anda Boreas bunu kendisi fark eder — bu pencereyi açık bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在“系统设置”中等待你的授权。一旦你允许，Boreas 会自行察觉——请保持此窗口打开。"
          }
        }
      }
    },
    "setup.approval.open": {
      "comment": "Button that opens the Login Items pane where the approval is granted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
