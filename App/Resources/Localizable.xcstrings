    "control.override.indefinite": {
      "comment": "Caption while an open-ended manual override is running",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are driving the fans until you hand them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás controlando los ventiladores hasta que devuelvas el control."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторами управляете вы, пока не вернёте управление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanları siz sürüyorsunuz; direksiyonu bırakana kadar böyle kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇由你控制，直到你交还控制权。"
          }
        }
      }
    },
