    "diagnostics.cause.airflow": {
      "comment": "Possible explanation for thermal pressure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricted airflow around the machine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flujo de aire restringido alrededor del equipo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный поток воздуха вокруг компьютера"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinenin çevresinde hava akışının kısıtlı olması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器周围的气流受阻"
          }
        }
      }
    },
    "diagnostics.cause.battery.aged": {
      "comment": "Possible cause offered first for a worn battery: it is expected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal ageing — every battery holds less as it goes through charge cycles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envejecimiento normal: toda batería retiene menos a medida que acumula ciclos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычное старение — любая батарея с циклами держит меньше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal yaşlanma — her pil şarj döngüleri geçtikçe daha az şarj tutar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常老化——任何电池随着充电循环增加，能储存的电量都会减少"
          }
        }
      }
    },
    "diagnostics.cause.battery.service": {
      "comment": "Possible cause for a worn battery, phrased without diagnosing it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A condition worth having looked at, if the figure keeps falling faster than the cycles explain"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que conviene revisar si la cifra sigue bajando más rápido de lo que explican los ciclos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние, которое стоит показать специалисту, если значение падает быстрее, чем объясняют циклы"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer, döngü sayısının açıkladığından daha hızlı düşmeye devam ederse baktırmaya değer bir durum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果数值下降的速度超出循环次数所能解释的范围，这一状况值得请人查看"
          }
        }
      }
    },
    "diagnostics.cause.battery.temperature": {
      "comment": "Possible cause for a warm battery",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charging while the machine is already warm, or in a warm room"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar cuando el equipo ya está caliente, o en una habitación cálida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядка, когда компьютер уже тёплый, или в тёплом помещении"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine zaten sıcakken ya da sıcak bir odada şarj etmek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在机器已经发热时充电，或在温度较高的房间里充电"
          }
        }
      }
    },
    "diagnostics.cause.connection": {
      "comment": "Possible explanation for a fan not following its command",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fan or cable that is not connected as firmly as it was"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ventilador o un cable que ya no está tan firme como estaba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентилятор или шлейф, подключённый не так плотно, как раньше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eskisi kadar sıkı oturmayan bir fan ya da kablo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇或排线不像原来那样接得牢固"
          }
        }
      }
    },
    "diagnostics.cause.differentparts": {
      "comment": "Possible explanation for two fans running at different speeds",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans are cooling different parts of the machine and are meant to differ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores refrigeran partes distintas del equipo y deben diferir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы охлаждают разные части компьютера, и разница задумана"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanların makinenin farklı bölümlerini soğutuyor ve farklı dönmeleri gerekiyor olması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个风扇在为机器的不同部位散热，本来就应该有差异"
          }
        }
      }
    },
    "diagnostics.cause.disk.full": {
      "comment": "Possible cause for a nearly full drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very little free space left on the drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda muy poco espacio libre en el disco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На диске осталось очень мало свободного места"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskte çok az boş alan kalmış olması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘剩余空间已经很少"
          }
        }
      }
    },
    "diagnostics.cause.disk.snapshots": {
      "comment": "Possible cause for a nearly full drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large files, or local backup snapshots the system is keeping"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos grandes, o instantáneas de copia de seguridad que el sistema conserva"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большие файлы или локальные снимки резервных копий, которые хранит система"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosyalar ya da sistemin tuttuğu yerel yedek anlık görüntüleri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较大的文件，或系统保留的本地备份快照"
          }
        }
      }
    },
    "diagnostics.cause.disk.writes": {
      "comment": "Possible cause for a warm drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustained writing, which warms the drive's controller"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura sostenida, que calienta la controladora del disco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрерывная запись, которая нагревает контроллер диска"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskin denetleyicisini ısıtan sürekli yazma işlemi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续写入，会让磁盘控制器发热"
          }
        }
      }
    },
    "diagnostics.cause.dust": {
      "comment": "Possible explanation for a fan not following its command",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dust in the fan or the vents, which makes a fan slower than its command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polvo en el ventilador o en las rejillas, que lo hace más lento que su orden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пыль в вентиляторе или в решётках, из-за которой он медленнее команды"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandaki ya da havalandırmadaki toz — fanı komutunun gerisinde bırakır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇或散热孔里的灰尘，使风扇转得比指令要慢"
          }
        }
      }
    },
    "diagnostics.cause.firmware": {
      "comment": "Possible explanation for a fan not following its command",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The firmware overriding the requested speed for its own reasons"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware anulando la velocidad pedida por sus propios motivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошивка, переопределяющая запрошенную скорость по своим причинам"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donanım yazılımının, kendi gerekçeleriyle istenen hızı geçersiz kılması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固件出于自身原因覆盖了请求的转速"
          }
        }
      }
    },
    "diagnostics.cause.hardware": {
      "comment": "Possible explanation of last resort, phrased without accusing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something wrong with the hardware itself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que no va bien en el propio hardware"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не так с самим оборудованием"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donanımın kendisinde bir sorun olması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件本身存在某种问题"
          }
        }
      }
    },
    "diagnostics.cause.heavywork": {
      "comment": "Possible explanation for thermal pressure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustained heavy work, which is the ordinary reason"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo intenso sostenido, que es el motivo habitual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжительная тяжёлая нагрузка — обычная причина"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli ağır iş — olağan gerekçe budur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间高负载，这是最常见的原因"
          }
        }
      }
    },
    "diagnostics.cause.notresponding": {
      "comment": "Possible explanation for two fans running at different speeds",
      "extractionState": "manual",
