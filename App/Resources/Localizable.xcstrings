        }
      }
    },
    "diagnostics.finding.response.tracking": {
      "comment": "Fan response check: the fans are following their commands",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fans followed their targets to within %lld rpm on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanlar hedeflerini ortalama %lld dev/dk yaklaşıklıkla izledi."
          }
        }
      }
    },
    "diagnostics.finding.sensors.both": {
      "comment": "Sensor validity check: both out of range and unmoving readings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sensors are reporting oddly — outside anything physical: %@; unchanged all session: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sensörler tuhaf bildiriyor — fiziksel olmayan değerler: %@; oturum boyunca hiç değişmeyenler: %@."
          }
        }
      }
    },
    "diagnostics.finding.sensors.healthy": {
      "comment": "Sensor validity check: every sensor looks normal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld sensors are reporting plausible, changing values."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sensörün tamamı makul ve değişen değerler bildiriyor."
          }
        }
      }
    },
    "diagnostics.finding.sensors.outofrange": {
      "comment": "Sensor validity check: readings outside the plausible range",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sensors are reporting values outside anything physical: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sensörler fiziksel olarak mümkün olmayan değerler bildiriyor: %@."
          }
        }
      }
    },
    "diagnostics.finding.sensors.stuck": {
      "comment": "Sensor validity check: readings that never move",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sensors have not changed all session: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sensörler oturum boyunca hiç değişmedi: %@."
          }
        }
      }
    },
    "diagnostics.finding.sensors.unreadable": {
      "comment": "Sensor validity check: nothing to judge",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sensor is being read right now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda okunan sensör yok."
          }
        }
      }
    },
    "diagnostics.finding.thermal.calm": {
      "comment": "Thermal history check: the system never reported pressure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system reported no thermal pressure this session. Peak temperature: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem bu oturumda termal baskı bildirmedi. En yüksek sıcaklık: %@."
          }
        }
      }
    },
    "diagnostics.finding.thermal.nopeak": {
      "comment": "Stands in for a peak temperature that was never recorded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not recorded"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kaydedilmedi"
          }
        }
      }
    },
    "diagnostics.finding.thermal.pressure": {
      "comment": "Thermal history check: the system reported pressure during the session",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system reported serious pressure for %lld s and critical pressure for %lld s this session. Peak temperature: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem bu oturumda %lld sn ciddi, %lld sn kritik baskı bildirdi. En yüksek sıcaklık: %@."
          }
        }
      }
    },
    "diagnostics.finding.thermal.short": {
      "comment": "Thermal history check: not enough time observed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is too short to say anything about thermal history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum, termal geçmiş hakkında bir şey söyleyemeyecek kadar kısa."
          }
        }
      }
    },
    "diagnostics.honesty": {
      "comment": "States plainly what the diagnostics can and cannot know",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are observations, not verdicts. Boreas can measure what the hardware reports; it cannot see inside your Mac, so it never tells you something is faulty — it tells you what it measured and what could explain it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar gözlem, hüküm değil. Boreas donanımın bildirdiğini ölçebilir; Mac'inizin içini göremez. Bu yüzden size bir şeyin arızalı olduğunu asla söylemez — ne ölçtüğünü ve bunu nelerin açıklayabileceğini söyler."
          }
        }
      }
    },
    "diagnostics.pending.detail": {
      "comment": "Explains which diagnostic checks are missing and why",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery health and storage health are not among the checks above. They need hardware readings this build does not take yet, and neither can be verified on the Mac this was developed on. They are listed here so their absence is visible rather than implied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil sağlığı ve depolama sağlığı yukarıdaki kontroller arasında değil. Bu sürümün henüz almadığı donanım okumalarını gerektiriyorlar ve ikisi de bu uygulamanın geliştirildiği Mac'te doğrulanamıyor. Yoklukları ima edilmesin diye burada adlarıyla anılıyorlar."
          }
        }
      }
    },
    "diagnostics.pending.title": {
      "comment": "Heading above the checks this build does not perform",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kontrol edilmiyor"
          }
        }
      }
    },
    "diagnostics.step.earlierprofile": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a profile that engages the fans earlier"
          }
        },
        "tr": {
