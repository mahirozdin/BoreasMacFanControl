    "setup.approval.explain": {
      "comment": "Shown while the background item waits for approval in System Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your approval in System Settings. Boreas notices by itself once you allow it — leave this window open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Sistem Ayarları'nda onayınızı bekliyor. İzin verdiğiniz anda Boreas bunu kendisi fark eder — bu pencereyi açık bırakın."
          }
        }
      }
    },
    "setup.approval.open": {
      "comment": "Button that opens the Login Items pane where the approval is granted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nı Aç"
          }
        }
      }
    },
    "setup.failed": {
      "comment": "Introduces the raw system error message after a failed step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work. The system said:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işe yaramadı. Sistemin söylediği:"
          }
        }
      }
    },
    "setup.files.bundle": {
      "comment": "Setup bullet: SMAppService keeps the helper inside the app bundle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper program and its launch definition already sit inside the Boreas app. Installing copies nothing into system folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı program ve onun başlatma tanımı zaten Boreas uygulamasının içinde duruyor. Kurulum sistem klasörlerine hiçbir şey kopyalamaz."
          }
        }
      }
    },
    "setup.files.heading": {
      "comment": "Heading of the setup section listing file system effects",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is written where"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nereye ne yazılıyor"
          }
        }
      }
    },
    "setup.files.registry": {
      "comment": "Setup bullet: the only system-side record is the background item registration",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS records the approval in its background items database. The entry is visible in System Settings under Login Items & Extensions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS onayı arka plan öğeleri veritabanına kaydeder. Kayıt, Sistem Ayarları'nda Giriş Öğeleri ve Uzantılar altında görünür."
          }
        }
      }
    },
    "setup.install.button": {
      "comment": "Button that starts the helper installation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Fan Control Helper"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan Kontrol Yardımcısını Kur"
          }
        }
      }
    },
    "setup.installing": {
      "comment": "Progress text while the helper is being registered",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registering the helper…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı kaydediliyor…"
          }
        }
      }
