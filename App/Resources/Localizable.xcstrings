      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekleme"
          }
        }
      }
    },
    "settings.general.section.startup": {
      "comment": "Settings section heading: launch behaviour",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç"
          }
        }
      }
    },
    "settings.sensors.group": {
      "comment": "Sensor settings column: which group the sensor belongs to",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup"
          }
        }
      }
    },
    "settings.sensors.help": {
      "comment": "Explains what sensor overrides do and what hiding does not do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming or re-filing a sensor also changes which curve can follow it. Hiding one only removes it from the lists: it is still read, still counts towards its group, and can still trigger the panic layer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sensörü yeniden adlandırmak ya da başka gruba almak, onu hangi eğrinin izleyebileceğini de değiştirir. Gizlemek ise yalnızca listelerden çıkarır: sensör okunmaya, grubunun hesabına katılmaya ve panik katmanını tetikleyebilmeye devam eder."
          }
        }
      }
    },
    "settings.sensors.name": {
      "comment": "Sensor settings column: the sensor's display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad"
          }
        }
      }
    },
    "settings.sensors.none": {
      "comment": "Shown in the sensor settings when nothing is readable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sensor is being read right now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda okunan sensör yok."
          }
        }
      }
    },
    "settings.sensors.report.clean": {
      "comment": "Shown when no sensor is uncategorized",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every sensor on this Mac was recognised."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki her sensör tanındı."
          }
        }
      }
    },
    "settings.sensors.report.count": {
      "comment": "Reports how many sensors the classifier could not place",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recognised: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanınmayan: %lld"
          }
        }
      }
    },
    "settings.sensors.report.detail": {
      "comment": "Explains what happens to sensors the classifier cannot place",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrecognised sensors are still read and still shown. Filing them below teaches this Mac, and the unknown-sensor issue template shares the fix with everyone else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanınmayan sensörler yine de okunur ve yine de gösterilir. Aşağıda onları gruplamak bu Mac'e öğretir; bilinmeyen sensör konu şablonu ise çözümü herkesle paylaşır."
          }
        }
      }
    },
    "settings.sensors.section.list": {
      "comment": "Settings section heading: the editable sensor list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sensors"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm sensörler"
          }
        }
      }
    },
    "settings.sensors.section.report": {
