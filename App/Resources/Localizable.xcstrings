    "diagnostics.step.battery": {
      "comment": "Suggested next step for a battery notice",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the battery information in System Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara con la información de la batería en Ajustes del Sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните с данными о батарее в Системных настройках"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'ndaki pil bilgileriyle karşılaştırın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与“系统设置”中的电池信息作对比"
          }
        }
      }
    },
    "diagnostics.step.battery.heat": {
      "comment": "Suggested next step for a warm battery",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the machine cool before charging it hard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que el equipo se enfríe antes de cargarlo con fuerza"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте компьютеру остыть перед интенсивной зарядкой"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makineyi zorlayarak şarj etmeden önce soğumasını bekleyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大功率充电之前，先让机器凉下来"
          }
        }
      }
    },
    "diagnostics.step.disk.snapshots": {
      "comment": "Suggested next step for a nearly full drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether local backup snapshots are holding space"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si las instantáneas de copia de seguridad locales están ocupando espacio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, не занимают ли место локальные снимки резервных копий"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel yedek anlık görüntülerinin yer tutup tutmadığını kontrol edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查本地备份快照是否占用了空间"
          }
        }
      }
    },
    "diagnostics.step.disk.space": {
      "comment": "Suggested next step for a nearly full drive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up some space on the drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera algo de espacio en el disco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите немного места на диске"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskte biraz yer açın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在磁盘上腾出一些空间"
          }
        }
      }
    },
    "diagnostics.step.earlierprofile": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a profile that engages the fans earlier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba un perfil que active los ventiladores antes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте профиль, включающий вентиляторы раньше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanları daha erken devreye sokan bir profil deneyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试更早启动风扇的方案"
          }
        }
      }
    },
    "diagnostics.step.idle": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether the difference persists when the machine is idle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si la diferencia se mantiene con el equipo en reposo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, сохраняется ли разница в простое"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark, makine boştayken de sürüyor mu bakın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看机器空闲时这个差异是否仍然存在"
          }
        }
      }
    },
    "diagnostics.step.report": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report the sensor with the unknown-sensor issue template"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa del sensor con la plantilla de sensor desconocido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите о датчике через шаблон для неизвестных датчиков"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensörü bilinmeyen sensör konu şablonuyla bildirin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用“未知传感器”问题模板报告这个传感器"
          }
        }
      }
    },
    "diagnostics.step.underload": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the machine under load, when parked clusters wake up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara con el equipo bajo carga, cuando los clústeres aparcados despiertan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните под нагрузкой, когда приостановленные кластеры просыпаются"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makineyi yük altındayken karşılaştırın; park etmiş kümeler o zaman uyanır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在机器有负载、闲置核心簇被唤醒时再作对比"
          }
        }
      }
    },
    "diagnostics.step.vents": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the vents are clear"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que las rejillas están despejadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, свободны ли решётки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Havalandırmaların açık olduğunu kontrol edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查散热孔是否通畅"
          }
        }
      }
    },
    "diagnostics.step.watchload": {
      "comment": "Suggested next step",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch whether the deviation changes with load or stays constant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa si la desviación cambia con la carga o se mantiene constante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, меняется ли отклонение с нагрузкой или остаётся постоянным"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapmanın yükle değişip değişmediğine, yoksa sabit mi kaldığına bakın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察这个偏差是随负载变化还是保持不变"
          }
        }
      }
    },
