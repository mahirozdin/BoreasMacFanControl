# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Xcode — the generated project file (produced from project.yml via XcodeGen)
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/
build/
.build/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.swiftpm/
Package.resolved

# Build outputs and distribution artifacts
*.app
*.dmg
*.zip
*.pkg
dist/

# Signing and secrets — NEVER committed
*.p12
*.mobileprovision
*.provisionprofile
.env
.env.local
AuthKey_*.p8
ExportOptions.plist

# Local development
.vscode/
*.log
tmp/
.cache/

# Temporary gate script output
.gate-tmp/

# Local signing configuration — the team identifier is account information
# and never enters the repository
Local.xcconfig
