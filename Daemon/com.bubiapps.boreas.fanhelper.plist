<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bubiapps.boreas.fanhelper</string>

    <!-- SMAppService executes this path inside the application bundle. -->
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchDaemons/com.bubiapps.boreas.fanhelper</string>

    <!-- A single Mach service. That is the whole surface. -->
    <key>MachServices</key>
    <dict>
        <key>com.bubiapps.boreas.fanhelper</key>
        <true/>
    </dict>

    <!-- Starts on demand, stops when idle. A permanently running root
         process is a wider attack surface than one that starts when it is
         needed. -->
    <key>RunAtLoad</key>
    <false/>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.bubiapps.boreas</string>
    </array>
</dict>
</plist>
